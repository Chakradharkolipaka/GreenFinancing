{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "scripts",
    "test",
    "typechain-types",
    "ignition/modules"
  ]
}
